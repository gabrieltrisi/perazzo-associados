// Banco do mini-CMS. PostgreSQL (Neon) em dev e produção — DATABASE_URL vem do
// ambiente. Aplique o schema com `prisma migrate deploy`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Conteúdo editável do site: cada seção (home, contato, faq, ...) é uma linha,
// com o JSON serializado em `data`. String (não Json) para portabilidade entre
// SQLite e Postgres.
model SiteContent {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}

// Artigos do blog — editáveis pelo painel (antes eram arquivos MDX).
model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @default("")
  excerpt     String   @default("")
  autor       String   @default("")
  date        String   @default("") // YYYY-MM-DD
  content     String   @default("") // Markdown/MDX
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Contador simples de visitas por página e dia (resumo no painel).
// Agregado (não guarda 1 linha por acesso) para não crescer sem controle.
model PageView {
  id    Int    @id @default(autoincrement())
  path  String
  day   String // YYYY-MM-DD
  count Int    @default(0)

  @@unique([path, day])
  @@index([day])
}
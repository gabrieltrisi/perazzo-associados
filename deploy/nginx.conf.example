# Nginx como proxy reverso pro Next (porta 3000). Ajuste o server_name.
# Copie para /etc/nginx/sites-available/perazzo e ative com symlink em sites-enabled.
# Depois rode o Certbot (--nginx) que ele adiciona o bloco HTTPS automaticamente.

server {
    listen 80;
    server_name perazzoadvogados.com.br www.perazzoadvogados.com.br;

    # Corpo maior p/ formulários/uploads futuros
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # IMPORTANTE: repassa o IP real do visitante (o rate-limit depende disso)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente do site Perazzo & Associados
# Copie para `.env.local` (dev) ou configure na Vercel (produção).
# NENHUM valor real deve ser commitado — este arquivo é só o modelo.
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada em canonical, OG, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://perazzoadvogados.com.br"

# ── Banco de dados (mini-CMS / painel admin) — PostgreSQL (Neon) ──
# Connection string do Neon (use a versão "pooled", que contém "-pooler").
# Ex.: postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:senha@host-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# ── Admin do site (dono único) ──
# JWT_SECRET: gere um aleatório -> node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL="dono@perazzoadvogados.com.br"
ADMIN_PASSWORD="troque-esta-senha"
JWT_SECRET="cole-um-segredo-aleatorio-aqui"

# ── Formulário de contato — destino ──
CONTACT_EMAIL_TO="contato@perazzoadvogados.com.br"
CONTACT_EMAIL_FROM="Perazzo & Associados <contato@perazzoadvogados.com.br>"

# ── Envio via SMTP do Zoho (PREFERIDO) ──
# Gere uma "Senha de aplicativo" no Zoho (Settings > Security > App Passwords),
# usando a conta contato@perazzoadvogados.com.br. Sem ZOHO_SMTP_PASS o form NÃO envia.
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="contato@perazzoadvogados.com.br"
ZOHO_SMTP_PASS=""

# ── Alternativa: Resend (só se NÃO usar o Zoho) ──
# Crie a chave em https://resend.com/api-keys e verifique o domínio remetente.
RESEND_API_KEY=""

# ── Anti-spam (reCAPTCHA v3) ──
# https://www.google.com/recaptcha/admin (opcional em dev; recomendado em prod).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ── WhatsApp (formato internacional, só dígitos: 55 + DDD + número) ──
NEXT_PUBLIC_WHATSAPP_NUMBER="5571999999999"

# ── Google Maps (URL do iframe "Incorporar um mapa") ──
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
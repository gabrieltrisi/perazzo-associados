# ==========================================================================
# Variáveis de ambiente — Perazzo & Associados
# Copie este arquivo para `.env.local` e preencha os valores reais.
# O `.env.local` NUNCA é commitado (está no .gitignore).
# ==========================================================================

# --- E-mail (formulário de contato via Resend) ---
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=
# Para onde as mensagens do formulário são enviadas (e-mail institucional):
CONTACT_EMAIL_TO=
# Remetente verificado no Resend (ex.: contato@perazzoadvogados.com.br):
CONTACT_EMAIL_FROM=

# --- reCAPTCHA v3 (anti-spam) ---
# Crie em https://www.google.com/recaptcha/admin  (tipo: reCAPTCHA v3)
# Se ficarem VAZIAS, o formulário funciona normalmente em dev (sem captcha).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- WhatsApp (botão flutuante) ---
# Número no formato internacional, só dígitos: 55 + DDD + número
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Google Maps (embed na página de Contato) ---
# URL do embed "incorporar mapa" do Google Maps (o src do iframe)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- URL pública do site (usada em sitemap/robots/OpenGraph) ---
NEXT_PUBLIC_SITE_URL=https://perazzoadvogados.com.br